# Server-side credentials only. Never add a NEXT_PUBLIC_ prefix.
# Blank key uses deterministic local fallback; it does not meet hackathon inference requirements.
NEBIUS_API_KEY=
# Defaults follow the official Nebius Nemotron Super cookbook (2026-10-26).
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional per-tier overrides (lib/agents/models.ts). Blank uses the tier default.
NEBIUS_MODEL_NANO=
NEBIUS_MODEL_SUPER=
NEBIUS_MODEL_ULTRA=
# Optional completion cap for scripts/smoke-token-factory.ts (default 4096).
NEBIUS_SMOKE_MAX_TOKENS=

# Optional external-disruption search. Blank key returns illustrative fixtures.
TAVILY_API_KEY=
